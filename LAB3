import pandas as pd

# Read the dataset
data = pd.read_csv("workload_data.csv")

print("===== DATASET =====")
print(data)

# Number of attributes (excluding target class)
num_attributes = len(data.columns) - 1

# Initialize the most specific hypothesis
hypothesis = ['0'] * num_attributes

print("\nInitial Hypothesis:")
print(hypothesis)

print("\nProcessing Positive Examples...\n")

# Process each row
for index, row in data.iterrows():

    print(f"Row {index + 1}")

    # Check if it is a positive example
    if row["High-Performance Edge"] == "Yes":

        attributes = row[:-1].tolist()

        # First positive example
        if hypothesis[0] == '0':
            hypothesis = attributes.copy()

        else:
            # Generalize the hypothesis
            for i in range(num_attributes):
                if hypothesis[i] != attributes[i]:
                    hypothesis[i] = '?'

    print("Current Hypothesis:", hypothesis)
    print("-----------------------------------")

print("\nFinal Specific Hypothesis:")
print(hypothesis)
